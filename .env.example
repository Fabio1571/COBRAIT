NODE_ENV=production
PORT=4000
HOST=0.0.0.0
SITE_URL=https://cobrait.pt

STORAGE_MODE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=cpaneluser_cobrait
MYSQL_USER=cpaneluser_cobrait
MYSQL_PASSWORD=change-this-password

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h
SESSION_COOKIE_NAME=cobrait_admin_session
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_HOURS=12
CORS_ORIGINS=https://example.com

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=COBRAIT Admin

NOTIFICATION_EMAIL_TO=clientes@cobrait.pt
NOTIFICATIONS_DISABLED=false
LEAD_CONFIRMATION_ENABLED=true
NOTIFICATION_EMAIL_FROM=COBRAIT <geral@cobrait.pt>
SMTP_HOST=mail.cobrait.pt
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=geral@cobrait.pt
SMTP_PASSWORD=change-this-email-password

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini

# Agendamento Cal.com (configurar depois de criar a conta COBRAIT)
CALCOM_BOOKING_URL=
CALCOM_WEBHOOK_SECRET=

# Zoho CRM EU — criar uma aplicação OAuth com o scope ZohoCRM.modules.leads.CREATE
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_LEAD_MODULE=Leads
ZOHO_TRIGGER_WORKFLOWS=false
