<!doctype html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,follow">
  <title>{{ 'Página não encontrada' if locale == 'pt' else 'Page not found' }} — COBRAIT</title>
  <link rel="icon" href="/assets/images/favicon/favicon.ico" sizes="any">
  <link rel="stylesheet" href="/assets/css/site-v2.css?v=20261015a">
</head>
<body class="site-v2">
  <main id="main-content" class="not-found-page">
    <div class="shell">
      <a class="brand" href="{{ home }}"><span class="brand-word">COBRAIT</span></a>
      <p class="not-found-code">404</p>
      <h1>{{ 'Esta página já não está aqui.' if locale == 'pt' else 'This page is no longer here.' }}</h1>
      <p>{{ 'Pode ter sido movida durante a reestruturação do website ou o endereço pode estar incorreto.' if locale == 'pt' else 'It may have moved during the website restructure, or the address may be incorrect.' }}</p>
      <a class="button button-primary" href="{{ home }}">{{ 'Voltar à página inicial' if locale == 'pt' else 'Back to the homepage' }}<span aria-hidden="true">→</span></a>
    </div>
  </main>
  <footer class="site-footer site-footer-compact">
    <div class="shell">
      <span>© {{ year }} COBRAIT.</span>
      <a class="complaints-book-link" href="https://www.livroreclamacoes.pt/inicio" target="_blank" rel="noopener noreferrer">
        <img src="/assets/images/logo-lre-vermelho-negativo.png" alt="{{ 'Electronic Complaints Book' if locale == 'en' else 'Livro de Reclamações Eletrónico' }}" width="140" height="58" decoding="async">
        <span class="sr-only">{{ ' (opens in a new tab)' if locale == 'en' else ' (abre num novo separador)' }}</span>
      </a>
    </div>
  </footer>
</body>
</html>
