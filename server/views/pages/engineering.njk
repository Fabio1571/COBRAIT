{% extends "layouts/base.njk" %}
{% block content %}
<section class="page-hero engineering-hero section-dark">
  <div class="shell page-hero-grid">
    <p class="eyebrow eyebrow-light" data-cms-key="hero.kicker">{{ page.hero.kicker }}</p>
    <h1 data-cms-key="hero.title">{{ page.hero.title }}</h1>
    <p class="hero-text" data-cms-key="hero.text">{{ page.hero.text }}</p>
  </div>
  {% include "partials/technical-diagram.njk" %}
</section>
<section class="section engineering-capabilities section-dark" data-cms-remove-key="block.engineering.capabilities">
  <div class="shell capability-grid">
    {% for item in page.capabilities %}
    <article class="capability-item reveal"><span>0{{ loop.index }}</span><h2 data-cms-key="capabilities.{{ loop.index0 }}.title">{{ item.title }}</h2><p data-cms-key="capabilities.{{ loop.index0 }}.text">{{ item.text }}</p></article>
    {% endfor %}
  </div>
</section>
<section class="section stack-statement" data-cms-remove-key="block.engineering.stack">
  <div class="shell editorial-intro">
    <h2>{{ 'Ferramentas ao serviço do produto.' if locale == 'pt' else 'Tools in service of the product.' }}</h2>
    <p data-cms-key="stackNote">{{ page.stackNote }}</p>
  </div>
  <div class="shell stack-rail" aria-label="{{ 'Áreas tecnológicas' if locale == 'pt' else 'Technology areas' }}">
    <span>Web applications</span><span>Node.js</span><span>Relational data</span><span>APIs</span><span>Cloud</span><span>Automation</span>
  </div>
</section>
{% include "partials/final-cta.njk" %}
{% endblock %}
