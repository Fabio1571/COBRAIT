<section class="section section-cta">
  <div class="shell">
    <div class="cta-panel">
      <p class="eyebrow eyebrow-light" data-cms-scope="global" data-cms-key="common.response.{{ locale }}">{{ shared.common.response }}</p>
      <h2 data-cms-scope="global" data-cms-key="common.finalCtaTitle.{{ locale }}">{{ shared.common.finalCtaTitle }}</h2>
      <p data-cms-scope="global" data-cms-key="common.finalCtaText.{{ locale }}">{{ shared.common.finalCtaText }}</p>
      <a class="button button-light" href="{{ paths.booking }}" data-track="final_booking"><span data-cms-scope="global" data-cms-key="common.talk.{{ locale }}">{{ shared.common.talk }}</span><span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
